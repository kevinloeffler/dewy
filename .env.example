# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Encrypts the LLM providers' API keys in the database. 32 bytes, base64 or hex:
#   openssl rand -base64 32
# Without it no provider can be saved. Changing it makes stored keys unreadable;
# they then have to be typed in again.
LLM_SECRET_KEY=""

# Production only (adapter-node): max request body. Image uploads go up to 5 MB.
# Dockerfile.prod sets this; `vite dev` has no such limit.
# BODY_SIZE_LIMIT=6M

# Production only, behind a reverse proxy: which header carries the client IP,
# so /login counts failed sign-ins per client rather than per proxy.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
